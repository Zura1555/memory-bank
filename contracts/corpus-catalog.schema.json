{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-bank.invalid/contracts/corpus-catalog.schema.json",
  "title": "Memory Bank source authoring catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "corpusVersion", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "corpusVersion": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "cases": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caseId", "title", "fictional", "artifacts"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "fictional": { "const": true },
        "artifacts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/artifact" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactId", "title", "fictional", "versions"],
      "properties": {
        "artifactId": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "fictional": { "const": true },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/version" }
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["versionId", "sourcePath", "mimeType", "statedDate"],
      "properties": {
        "versionId": { "$ref": "#/$defs/id" },
        "sourcePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
        "mimeType": { "type": "string", "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+-]+$" },
        "statedDate": { "type": ["string", "null"] }
      }
    }
  }
}
