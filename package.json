{
  "name": "memory-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf build --mode development && vite preview --mode development --host 127.0.0.1 --port 8787",
    "build": "cf build",
    "preview": "vite preview --host 127.0.0.1 --port 8787",
    "deploy": "cf deploy --mode production --secrets-file .dev.vars.production",
    "deploy:check": "cf deploy --dry-run --mode production",
    "smoke:production": "node --network-family-autoselection-attempt-timeout=2000 --env-file=.dev.vars.production scripts/smoke-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/**/*.test.ts && python3 -m unittest discover -s ingestion -p '*_test.py'",
    "ingest": "python3 ingestion/build_manifest.py",
    "publish:corpus": "python3 ingestion/publish_corpus.py",
    "publish:corpus:production": "python3 ingestion/publish_corpus.py --production"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.1",
    "@cloudflare/workers-types": "5.20261014.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cf": "1.0.0-beta.17",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
