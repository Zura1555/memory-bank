{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memory-bank",
  "main": "src/server/worker.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    { "binding": "ORIGINALS", "bucket_name": "memory-bank-originals" }
  ],
  "queues": {
    "producers": [
      { "binding": "JOB_QUEUE", "queue": "memory-bank-jobs" }
    ],
    "consumers": [
      {
        "queue": "memory-bank-jobs",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "memory-bank-jobs-dead",
        "max_concurrency": 1
      }
    ]
  },
  "workflows": [
    { "name": "memory-bank-workflow", "binding": "WORKFLOW", "class_name": "MemoryBankWorkflow" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "APP_ENV": "development" }
}
