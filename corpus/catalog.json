        {
          "kind": "source_fact",
          "recordId": "elm-batch-count-discrepancy",
          "caseId": "elm-bulk-integration",
          "basis": "source_fact",
          "assertion": "The Elm StayLedger v4 / PaySpring Connect v3 sandbox delivery log reports that the 600-item batch was rejected with no adjustments applied, then split into two 300-item batches; it records four intentionally malformed amounts and says the target returned item-level rejects. The later entry says the second 300-item batch ended with two rejects and the client confirmed 598 of 600 accepted across tests. These statements are unreconciled: retain four malformed amounts, two second-batch rejects, and the 598/600 total as distinct reports. Do not infer that the two rejects explain the malformed amounts or that a reconciled accepted total was verified.",
          "applicability": "Historical Elm sandbox import run only; the source reports are not reconciled.",
          "evidence": [
            { "caseId": "elm-bulk-integration", "artifactId": "delivery-log", "versionId": "notes-2025-04-17", "passageId": "p-f0307a32de54738459c000dce90f00a3" },
